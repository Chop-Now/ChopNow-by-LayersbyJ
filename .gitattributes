# Normalize line endings to LF for all text files
* text=auto eol=lf

# Force binary (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.webp binary
*.zip binary
*.gz binary
*.tar binary
