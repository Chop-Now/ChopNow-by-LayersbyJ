# Copy to .env and fill in real values before running `docker-compose up`.
# docker-compose.yml refuses to start without these (see the ${VAR:?...}
# guards) - this is deliberate, so a fresh checkout can never accidentally
# run production with a placeholder secret or an open database.

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# MongoDB root credentials for the `mongo` container.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Comma-separated list of origins allowed to call the API. Optional - falls
# back to localhost origins for local dev if left unset.
ALLOWED_ORIGINS=http://localhost,http://localhost:5173
