# =============================================================================
# ChopNow Backend – Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials
# =============================================================================

# --- Required (app will not start without these) ---

# MongoDB Connection String
# Get from MongoDB Atlas: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chopnow?retryWrites=true&w=majority

# JWT Secret - Generate a strong random string (min 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Field-level encryption key for rider nationalId/licensePlate (M5) - a
# base64-encoded 256-bit key. Required the first time any code reads/writes
# those fields (rider application, admin rider review/list); losing this key
# makes existing encrypted values permanently unreadable, so store it the
# same way you'd store any other production secret, not just in .env.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# --- CORS (required in production) ---
# Comma-separated list of allowed frontend origins. No spaces.
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Production example:
# ALLOWED_ORIGINS=https://app.chopnow.com,https://www.chopnow.com

# --- Image Uploads (Cloudinary) ---
# Required for avatar/listing/business image uploads
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email Service (Brevo) ---
# Required for email verification, password reset, OTP, order notifications
# Get API key from: https://app.brevo.com/settings/keys
BREVO_API_KEY=your_brevo_api_key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=ChopNow
FRONTEND_URL=http://localhost:5173

# --- Google OAuth ---
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Observability (optional, recommended in production) ---
# Sentry error tracking DSN
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# --- Admin Recovery (optional) ---
# Secret key for emergency maintenance mode recovery

# --- Firebase Admin SDK (Push Notifications) ---
# Required for real push notifications. Without these, push runs in DRY-RUN mode (logged only).
# Get these from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Option A: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_KEY=./config/firebase-service-account.json
# Option B: Inline credentials (escape newlines in private key with \\n)
# FIREBASE_PROJECT_ID=chopnow-xxxxx
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@chopnow-xxxxx.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n

# --- pawaPay (Mobile Money Payments) ---
PAWAPAY_API_KEY=your_pawapay_api_key_here
# In production this MUST be exactly "production" - the server refuses to
# start otherwise (M6). Never left unset/guessed at runtime.
PAWAPAY_ENVIRONMENT=sandbox
PAWAPAY_WEBHOOK_URL=http://localhost:5000/api/v1/payments/webhook
PAWAPAY_PUBLIC_KEY=
# Sandbox/local-dev only escape hatch: lets webhook.js accept an unsigned
# pawaPay callback when you don't have real signature headers to test with
# (e.g. curling the webhook manually). NEVER set to true in production - the
# server refuses to start if it is (M6). Leave unset otherwise.
# PAWAPAY_ALLOW_UNSIGNED_WEBHOOKS=true

# --- Payment Testing ---
# Set to true to bypass the real pawaPay API during development/staging tests.
# A simulated COMPLETED webhook fires 5 seconds after deposit is initiated.
# Set to false (or remove) when using real pawaPay sandbox or production.
PAYMENT_TEST_MODE=false
BACKEND_URL=https://your-backend.onrender.com


